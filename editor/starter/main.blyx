use vendor::pelican::pelican;

fn main() {
    let starts = [0, 5, 20];
    let lengths = [4, 3, 2];
    let gap = 1.0;
    let block = 8.0;
    let result = pelican_reads(starts, lengths, gap, block);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
